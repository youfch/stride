<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideEditorTargetFramework)</TargetFramework>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--auto-module-initializer --serialization</StrideAssemblyProcessorOptions>
    <StrideLocalized>true</StrideLocalized>
    <!-- UI Framework: Wpf or Avalonia -->
    <UIFramework Condition="'$(UIFramework)' == ''">Wpf</UIFramework>
    <DefineConstants Condition="'$(UIFramework)' == 'Avalonia'">$(DefineConstants);AVALONIA</DefineConstants>
    <DefineConstants Condition="'$(UIFramework)' == 'Wpf'">$(DefineConstants);WPF</DefineConstants>
    <UseWPF Condition="'$(UIFramework)' == 'Wpf'">true</UseWPF>
    <EnableDefaultPageItems Condition="'$(UIFramework)' == 'Wpf'">false</EnableDefaultPageItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- WPF-specific items -->
  <ItemGroup Condition="'$(UIFramework)' == 'Wpf' Or '$(UIFramework)' == ''">
    <Page Include="**\*.xaml" SubType="Designer" Generator="MSBuild:Compile" />
    <Compile Update="**\*.xaml.cs" SubType="Code" DependentUpon="%(Filename)" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
  </ItemGroup>

  <!-- Avalonia-specific items (for dual-build compatibility) -->
  <ItemGroup Condition="'$(UIFramework)' == 'Avalonia'">
    <!-- Avalonia projects use separate .csproj, this is a placeholder -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Stride.Core.Design\Stride.Core.Design.csproj" />
    <ProjectReference Include="..\..\presentation\Stride.Core.Translation.Presentation\Stride.Core.Translation.Presentation.csproj" />
    <ProjectReference Include="..\Stride.Core.Presentation\Stride.Core.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Cursors\CursorDrag.cur" />
    <Resource Include="Resources\Images\calendar--pencil.png" />
    <Resource Include="Resources\Images\close_window.png" />
    <Resource Include="Resources\Images\error-32.png" />
    <Resource Include="Resources\Images\info-32.png" />
    <Resource Include="Resources\Images\question-32.png" />
    <Resource Include="Resources\Images\gear--pencil.png" />
    <Resource Include="Resources\Images\lock-unlock.png" />
    <Resource Include="Resources\Images\lock.png" />
    <Resource Include="Resources\Images\eraser.png" />
    <Resource Include="Resources\Images\ruler-triangle.png" />
    <Resource Include="Resources\Images\cursor_north_south.png" />
    <Resource Include="Resources\Images\cursor_west_east.png" />
    <Resource Include="Resources\Images\warning-32.png" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
</Project>
