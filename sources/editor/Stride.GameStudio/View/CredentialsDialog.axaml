<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Stride.GameStudio.View.CredentialsDialog"
        Title="Credentials"
        Width="450" Height="425"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:CompileBindings="False">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock TextWrapping="Wrap"
               Text="Provide information about the host to connect to. Your password is encrypted on this machine." />
    <TextBlock Text="Host" />
    <TextBox x:Name="Host" />
    <TextBlock Text="Port" />
    <NumericUpDown x:Name="Port" Minimum="1" Maximum="65535" Value="22" />
    <TextBlock Text="Username" />
    <TextBox x:Name="Username" />
    <TextBlock Text="Password" />
    <TextBox x:Name="Password" PasswordChar="*" />
    <TextBlock Text="Location" />
    <TextBox x:Name="Location" />
    <CheckBox x:Name="CheckBox" Content="Don't ask again" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
      <Button Content="Test settings" Click="OnTestSettings" />
      <Button Content="Save" Click="OnOk" />
      <Button Content="Cancel" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>