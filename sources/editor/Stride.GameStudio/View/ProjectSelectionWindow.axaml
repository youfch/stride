<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stride.GameStudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Stride.GameStudio.View.ProjectSelectionWindow"
        x:CompileBindings="False"
        Title="Project Selection"
        Width="1024" Height="768"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        d:DataContext="{d:DesignInstance vm:GameStudioViewModel}">
  <DockPanel>
    <!-- Bottom panel with buttons -->
    <DockPanel DockPanel.Dock="Bottom" Margin="20">
      <Button DockPanel.Dock="Left" Content="Browse for existing project" 
              Command="{Binding OpenSessionCommand}" Padding="20,6"/>
      <CheckBox DockPanel.Dock="Left" Margin="8,0,20,0"
                Content="Reload last session automatically at startup"
                IsChecked="{Binding ReloadLastSession}"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" Padding="20,6" Margin="10,0,0,0" IsCancel="True"/>
      </StackPanel>
    </DockPanel>

    <!-- Main content area - template browser or project list -->
    <StackPanel Margin="20" Spacing="10">
      <TextBlock Text="Select a project template or open an existing project:" 
                 FontSize="16" FontWeight="Bold"/>
      
      <ListBox ItemsSource="{Binding AvailableTemplates}" 
               SelectedItem="{Binding SelectedTemplate}"
               Height="400">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="5">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
              <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Button Content="Create New Project from Selected Template" 
              Command="{Binding CreateNewSessionCommand}" 
              Padding="20,6" Margin="0,10,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
