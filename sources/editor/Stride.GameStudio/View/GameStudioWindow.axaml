<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stride.GameStudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Stride.GameStudio.View.GameStudioWindow"
        x:CompileBindings="False"
        Title="{Binding EditorTitle, RelativeSource={RelativeSource Self}}"
        Width="1280" Height="900"
        d:DataContext="{d:DesignInstance vm:GameStudioViewModel}"
        x:Name="EditorWindow">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- MENU -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewSessionCommand}" />
        <MenuItem Header="_Open" Command="{Binding OpenSessionCommand}" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding Session.SaveSessionCommand}" />
        <Separator />
        <MenuItem Header="_Quit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding Session.ActionHistory.UndoCommand}" />
        <MenuItem Header="_Redo" Command="{Binding Session.ActionHistory.RedoCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Solution Explorer" IsChecked="{Binding Panels.SessionExplorerPanelVisible, Mode=TwoWay}" />
        <MenuItem Header="_Asset View" IsChecked="{Binding Panels.AssetViewPanelVisible, Mode=TwoWay}" />
        <MenuItem Header="_Property Grid" IsChecked="{Binding Panels.PropertyGridPanelVisible, Mode=TwoWay}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About..." Command="{Binding OpenAboutPageCommand}" />
      </MenuItem>
    </Menu>

    <!-- TOOLBAR -->
    <WrapPanel Grid.Row="1" Margin="4,2">
      <Button Command="{Binding NewSessionCommand}" ToolTip.Tip="New Project" Margin="2,0">New</Button>
      <Button Command="{Binding OpenSessionCommand}" ToolTip.Tip="Open" Margin="2,0">Open</Button>
      <Button Command="{Binding Session.SaveSessionCommand}" ToolTip.Tip="Save" Margin="2,0">Save</Button>
      <Separator Width="1" Height="20" Margin="4,0" />
      <Button Command="{Binding Debugging.BuildProjectCommand}" ToolTip.Tip="Build" Margin="2,0">Build</Button>
      <Button Command="{Binding Debugging.StartProjectCommand}" ToolTip.Tip="Run" Margin="2,0">Run</Button>
    </WrapPanel>

    <!-- CONTENT AREA -->
    <Grid Grid.Row="2">
      <TextBlock Text="Avalonia 12 Editor"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="18" Opacity="0.5" />
    </Grid>

    <!-- STATUS BAR -->
    <Border Grid.Row="3" Background="{DynamicResource StrideStatusBarBrush}" Padding="8,4">
      <TextBlock Text="{Binding Status.StatusText, FallbackValue=Ready}" FontSize="11" Foreground="White" />
    </Border>
  </Grid>
</Window>
