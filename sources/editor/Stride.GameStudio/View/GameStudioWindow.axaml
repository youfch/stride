<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Stride.GameStudio.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Stride.GameStudio.View.GameStudioWindow"
        x:CompileBindings="False"
        Title="{Binding EditorTitle, RelativeSource={RelativeSource Self}}"
        Width="1280" Height="900"
        d:DataContext="{d:DesignInstance vm:GameStudioViewModel}"
        x:Name="EditorWindow">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- MENU -->
    <Menu Grid.Row="0" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewSessionCommand}" />
        <MenuItem Header="_Open" Command="{Binding OpenSessionCommand}" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding Session.SaveSessionCommand}" />
        <Separator />
        <MenuItem Header="_Quit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding Session.ActionHistory.UndoCommand}" />
        <MenuItem Header="_Redo" Command="{Binding Session.ActionHistory.RedoCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Solution Explorer"
                  IsChecked="{Binding Panels.SessionExplorerPanelVisible, Mode=TwoWay}" />
        <MenuItem Header="_Asset View"
                  IsChecked="{Binding Panels.AssetViewPanelVisible, Mode=TwoWay}" />
        <MenuItem Header="_Property Grid"
                  IsChecked="{Binding Panels.PropertyGridPanelVisible, Mode=TwoWay}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About..." Command="{Binding OpenAboutPageCommand}" />
      </MenuItem>
    </Menu>

    <!-- DOCK LAYOUT (visible when session is loaded) -->
    <Grid Grid.Row="1" x:Name="DockGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- Toolbar -->
        <RowDefinition Height="*"/>     <!-- Panels + Editor -->
      </Grid.RowDefinitions>

      <!-- TOOLBAR -->
      <WrapPanel Grid.Row="0" Margin="4,2">
        <Button Command="{Binding NewSessionCommand}" ToolTip.Tip="New Project" Margin="2,0">New</Button>
        <Button Command="{Binding OpenSessionCommand}" ToolTip.Tip="Open" Margin="2,0">Open</Button>
        <Button Command="{Binding Session.SaveSessionCommand}" ToolTip.Tip="Save" Margin="2,0">Save</Button>
        <Separator Width="1" Height="20" Margin="4,0" />
        <Button Command="{Binding Debugging.BuildProjectCommand}" ToolTip.Tip="Build" Margin="2,0">Build</Button>
        <Button Command="{Binding Debugging.StartProjectCommand}" ToolTip.Tip="Run" Margin="2,0">Run</Button>
      </WrapPanel>

      <!-- Panels + Editor -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <!-- LEFT: Solution Explorer -->
        <Border Grid.Column="0" Width="280"
                IsVisible="{Binding Panels.SessionExplorerPanelVisible}"
                BorderBrush="{DynamicResource StrideBorderBrush}" BorderThickness="0,0,1,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Solution Explorer"
                       FontSize="12" FontWeight="Bold"
                       Margin="8,6" Foreground="{DynamicResource StrideForegroundBrush}"/>
            <ScrollViewer>
              <TreeView x:Name="SolutionTreeView"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource StrideForegroundBrush}">
                <TreeViewItem Header="Loading..." IsEnabled="False"/>
              </TreeView>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- CENTER: Editor area / Asset View -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
          </Grid.RowDefinitions>

          <!-- Asset View -->
          <Border Grid.Row="0"
                  IsVisible="{Binding Panels.AssetViewPanelVisible}"
                  BorderBrush="{DynamicResource StrideBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Asset View"
                         FontSize="12" FontWeight="Bold"
                         Margin="8,6" Foreground="{DynamicResource StrideForegroundBrush}"/>
              <Border Background="{DynamicResource StrideDarkBackgroundBrush}" Margin="8">
                <TextBlock Text="Asset preview area"
                           Foreground="{DynamicResource StrideDisabledForegroundBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </DockPanel>
          </Border>

          <!-- Main editor / 3D preview -->
          <Border Grid.Row="1" Margin="8">
            <TextBlock Text="3D Scene Preview"
                       Foreground="{DynamicResource StrideDisabledForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>

        <!-- RIGHT: Property Grid -->
        <Border Grid.Column="2" Width="280"
                IsVisible="{Binding Panels.PropertyGridPanelVisible}"
                BorderBrush="{DynamicResource StrideBorderBrush}" BorderThickness="1,0,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Property Grid"
                       FontSize="12" FontWeight="Bold"
                       Margin="8,6" Foreground="{DynamicResource StrideForegroundBrush}"/>
            <ScrollViewer>
              <Border Background="{DynamicResource StrideDarkBackgroundBrush}" Margin="8"
                      MinHeight="200">
                <TextBlock Text="Property grid"
                           Foreground="{DynamicResource StrideDisabledForegroundBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Welcome message when no session loaded -->
    <Border Grid.Row="1" Background="{DynamicResource StrideDarkBackgroundBrush}"
            x:Name="WelcomePanel">
      <TextBlock Text="Welcome to Stride Game Studio. Open or create a project to get started."
                 Foreground="{DynamicResource StrideForegroundBrush}"
                 FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center" Margin="40"/>
    </Border>

    <!-- STATUS BAR -->
    <Border Grid.Row="2" Background="{DynamicResource StrideStatusBarBrush}" Padding="8,4">
      <TextBlock Text="{Binding Status.StatusText, FallbackValue=Ready}"
                 FontSize="11" Foreground="White" />
    </Border>
  </Grid>
</Window>
