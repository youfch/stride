<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    ================================================================
    Editor-specific framework definitions.
    ================================================================

    These properties are only available to projects using Stride.Sdk.Editor
    (or SDKs that compose it, like Stride.Sdk.Tests).

    - StrideEditorTargetFramework: Windows UI framework (WPF or Avalonia)
    - StrideXplatEditorTargetFramework: Cross-platform editor/tool projects
    - UIFramework: UI framework selection (Wpf/Avalonia, default: Avalonia)

    Dual-build mode: Set $(UIFramework)='Avalonia' (default) to build Avalonia UI,
    or $(UIFramework)='Wpf' to build WPF UI.
  -->

  <!-- Default UI framework to Avalonia (migration target) -->
  <PropertyGroup Condition="'$(UIFramework)' == ''">
    <UIFramework>Avalonia</UIFramework>
  </PropertyGroup>

  <!-- UI framework constants -->
  <PropertyGroup>
    <StrideEditorTargetFramework>$(StrideFrameworkWindows)</StrideEditorTargetFramework>
    <StrideXplatEditorTargetFramework>$(StrideFramework)</StrideXplatEditorTargetFramework>
  </PropertyGroup>

  <!-- Avalonia version for dual-build (12.0.3+ required by RoslynPad.Editor.Avalonia 5.0.0) -->
  <PropertyGroup>
    <AvaloniaVersion>12.0.3</AvaloniaVersion>
  </PropertyGroup>

</Project>
